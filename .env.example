# ==============================================================================
# STANLEAF - GLOBAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or use service-specific .env files in backend/ and frontend/
# ==============================================================================

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL Database (for subsequent database integration)
DATABASE_URL=postgresql://stanleaf:stanleaf_secret@localhost:5432/stanleaf_db
POSTGRES_USER=stanleaf
POSTGRES_PASSWORD=stanleaf_secret
POSTGRES_DB=stanleaf_db
POSTGRES_PORT=5432

# Local AI / Ollama Configuration (for subsequent AI integration)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
